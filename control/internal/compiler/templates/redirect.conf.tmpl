# Redirection host {{.ID}} — generated by Corvus. Do not edit.
server {
    listen {{.P.HTTPPort}};
{{- if .CertDir}}
    listen {{.P.HTTPSPort}} ssl;
{{- if .HTTP2}}
    http2 on;
{{- end}}
    ssl_certificate     {{.CertDir}}/fullchain.pem;
    ssl_certificate_key {{.CertDir}}/privkey.pem;
{{- end}}
    server_name {{join .Domains " "}};

    set $corvus_host "{{index .Domains 0}}";
    set $corvus_wr "-";
    set $corvus_rule "";
    set $corvus_cc "";
    set $corvus_body "";
    set $corvus_ban "";
    set $corvus_skip "";
    set $corvus_auth "off";

    # Bans, security rules (scope "all") and attack-pattern blocking (corvus/rules.lua).
    rewrite_by_lua_block { require("corvus.rules").rewrite("{{.RuleKey}}") }
{{- if and .CertDir .SSLForced}}

    set $corvus_https_redirect "";
    if ($scheme = http) { set $corvus_https_redirect 1; }
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- end}}

    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:{{.P.ACMEPort}};
    }
{{- if .AdvancedConfig}}

    # --- advanced configuration (operator supplied) ---
{{.AdvancedConfig}}
    # --- end advanced configuration ---
{{- end}}
{{- if not .HasRootLocation}}

    location / {
{{- if and .CertDir .SSLForced}}
        if ($corvus_https_redirect) { return 301 https://$host$request_uri; }
{{- end}}
        # The redirect is sent from Lua after the rule engine: a plain `return` would run
        # before rewrite_by_lua and bypass bans, security rules and exploit blocking.
        set $corvus_redirect "{{.Target}}";
        rewrite_by_lua_block {
            require("corvus.rules").rewrite("{{.RuleKey}}")
            return ngx.redirect(ngx.var.corvus_redirect, {{.HTTPCode}})
        }
    }
{{- end}}
}
