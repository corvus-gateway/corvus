# Redirection host {{.ID}} — generated by Corvus. Do not edit.
server {
    listen {{.P.HTTPPort}};
{{- if .P.IPv6}}
    listen [::]:{{.P.HTTPPort}};
{{- end}}
{{- if .CertDir}}
    listen {{.P.HTTPSPort}} ssl;
{{- if .P.IPv6}}
    listen [::]:{{.P.HTTPSPort}} ssl;
{{- end}}
{{- if .HTTP2}}
    http2 on;
{{- end}}
    ssl_certificate     {{.CertDir}}/fullchain.pem;
    ssl_certificate_key {{.CertDir}}/privkey.pem;
{{- end}}
    server_name {{join .Domains " "}};

    set $corvus_host "{{index .Domains 0}}";
    set $corvus_wr "-";
    set $corvus_rule "";
    set $corvus_cc "";
    set $corvus_body "";
    set $corvus_ban "";
    set $corvus_skip "";
    set $corvus_auth "off";

    # Bans, security rules (scope "all") and attack-pattern blocking (corvus/rules.lua).
    rewrite_by_lua_block { require("corvus.rules").rewrite("{{.RuleKey}}") }
{{- if and .CertDir .SSLForced}}

    set $corvus_https_redirect "";
    if ($scheme = http) { set $corvus_https_redirect 1; }
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- if .HasRootLocation}}
    # The advanced configuration defines "location /", which has no Corvus redirect:
    # redirect at server level (certificate validation excepted).
    if ($request_uri ~ "^/\.well-known/acme-challenge/") { set $corvus_https_redirect ""; }
    if ($corvus_https_redirect) { return 301 https://$host$request_uri; }
{{- end}}
{{- end}}

    location ^~ /.well-known/acme-challenge/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://corvus_acme;
    }

    # Security-rule challenge answers (corvus/challenge.lua), as on proxy hosts.
    location = /__corvus/challenge/verify {
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        limit_req zone=corvus_ch_api burst=20 nodelay;
        limit_req_status 429;
        default_type text/html;
        content_by_lua_block { require("corvus.rules").challenge_verify("{{.RuleKey}}") }
    }
{{- if .AdvancedConfig}}

    # --- advanced configuration (operator supplied) ---
{{.AdvancedConfig}}
    # --- end advanced configuration ---
{{- end}}
{{- if not .HasRootLocation}}

    location / {
{{- if and .CertDir .SSLForced}}
        if ($corvus_https_redirect) { return 301 https://$host$request_uri; }
{{- end}}
        # The redirect is sent from Lua after the rule engine: a plain `return` would run
        # before rewrite_by_lua and bypass bans, security rules and exploit blocking.
        set $corvus_redirect "{{.Target}}";
        rewrite_by_lua_block {
            require("corvus.rules").rewrite("{{.RuleKey}}")
            return ngx.redirect(ngx.var.corvus_redirect, {{.HTTPCode}})
        }
    }
{{- end}}
}
