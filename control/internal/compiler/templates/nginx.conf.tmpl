# Generated by Corvus (corvus-control). Do not edit — changes are overwritten.
# Version directory: {{.Dir}}

worker_processes  auto;
worker_rlimit_nofile 65535;
# After a reload, old workers finish their requests; long-lived connections (WebSockets,
# streams, slow downloads) are closed after this so old workers can't pile up in memory
# when configuration changes often. Clients reconnect to the new workers.
worker_shutdown_timeout 10m;
# JIT-compile the regular expressions known at load time (attack-pattern map, regex
# locations); Lua patterns use the "j" flag of ngx.re.
pcre_jit on;
error_log  stderr warn;   # fd 2 directly: /dev/stderr cannot be reopened after su-exec
pid        {{.P.DataDir}}/run/nginx.pid;

env CORVUS_WR_SECRET;
env CORVUS_WR_SECRET_PREV;
env CORVUS_DEBUG_KEY;
env CORVUS_CONSOLE_KEY;
env CORVUS_REDIS_HOST;
env CORVUS_REDIS_PORT;
env CORVUS_REDIS_SCRIPT;
env CORVUS_REDIS_USER;
env CORVUS_REDIS_PASSWORD;

events {
    worker_connections  8192;
}

http {
    include       {{.P.MimeTypes}};
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout 65s;
    server_tokens off;
    more_clear_headers Server;          # do not advertise the server software
    client_max_body_size 100m;

    # Compress text responses (proxy hosts can turn it off). Responses the upstream
    # already compressed are passed through; event streams are not buffered.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json
               application/xml application/rss+xml application/atom+xml application/manifest+json image/svg+xml;

    # Slow-client / resource exhaustion limits (F7)
    client_header_timeout 15s;
    client_body_timeout   30s;
    send_timeout          60s;
    keepalive_requests    1000;
    reset_timedout_connection on;
    large_client_header_buffers 4 16k;
    # Upstream response headers: room for large cookies/tokens (SSO apps); nginx's
    # 4k default answers 502 "upstream sent too big header". Overridable per host.
    proxy_buffer_size       16k;
    proxy_buffers           8 16k;
    proxy_busy_buffers_size 32k;
    limit_conn_zone $binary_remote_addr zone=corvus_conn_ip:10m;
    limit_conn corvus_conn_ip 2048;        # simultaneous connections per client IP (NAT-friendly; slow clients are cut by the timeouts above)
    limit_conn_status 429;
    # Waiting room status API: coarse per-IP flood guard (NAT-friendly). The real
    # limit is per session in Lua (each sid may poll at most a few times a second).
    limit_req_zone $binary_remote_addr zone=corvus_wr_api:10m rate=500r/s;
    # Security-rule challenge answers (/__corvus/challenge/verify): a browser posts once
    # per challenge, so a few per second per IP is plenty.
    limit_req_zone $binary_remote_addr zone=corvus_ch_api:10m rate=5r/s;
    server_names_hash_bucket_size 128;
    map_hash_bucket_size 128;

    # Request bodies are buffered outside the data volume so uploads cannot fill
    # the disk that holds the database and certificates (F7).
    client_body_temp_path /tmp/corvus-client-body;
    proxy_temp_path       /tmp/corvus-proxy;
    # fastcgi/uwsgi/scgi are not compiled into the Corvus OpenResty build (attack surface).

    ssl_protocols TLSv1.2 TLSv1.3;
    # Mozilla "intermediate": AEAD-only suites for TLS 1.2
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:corvus_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;             # no ticket key rotation → disable tickets

    lua_package_path "{{.P.LuaDir}}/?.lua;;";
    lua_shared_dict corvus_wr_state 1m;   # waiting room Redis circuit breaker
    lua_shared_dict corvus_wr_ip 10m;     # waiting room per-IP new-entry limiter
    lua_shared_dict corvus_bans 16m;      # banned client addresses (pushed by corvus-control)
    lua_shared_dict corvus_bb 16m;        # bad-behaviour counters per client IP and host (TTL = window)
    lua_shared_dict corvus_bb_q 2m;       # bad-behaviour settings and gateway bans not yet recorded
    lua_shared_dict corvus_ua 1m;         # "under attack" auto activations and exemptions (pushed by corvus-control)
    resolver {{.P.Resolver}} ipv6={{if .P.ResolverIPv6}}on{{else}}off{{end}} valid=30s;
    resolver_timeout 5s;

    # Security rules: cap PCRE backtracking so a pathological pattern cannot stall a worker.
    lua_regex_match_limit 100000;

    init_by_lua_block {
        require("corvus.waitroom").init("{{.Dir}}/policy.json")
        require("corvus.rules").init("{{.Dir}}/rules.json")
        require("corvus.accesslog").init("{{.P.DataDir}}/run/corvus-access.sock")
    }

    # Only WebSocket upgrades are forwarded; anything else (e.g. h2c) is dropped (F5).
    map $http_upgrade $corvus_upgrade {
        default        "";
        "~*^websocket$" websocket;
    }
    map $corvus_upgrade $corvus_connection_upgrade {
        default upgrade;
        ""      "";
    }

    # Upstream responses must not steer nginx internally (X-Accel-* headers).
    proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;

    # Known scanner / exploit request patterns. Logged for every host (detect-only);
    # hosts with "block exploits" enabled answer 403.
    # Matched against the raw request line AND the once-decoded path ("$request_uri $uri"),
    # so single/double percent-encoding variants (.%2e/, %252e%252e, %70hpunit) are caught.
    # All patterns are linear-time (no nested quantifiers).
    map "$request_uri $uri" $corvus_exploit {
        default "";
        "~*(?:\.|%2e|%252e)(?:\.|%2e|%252e)(?:[/\x5c]|%2f|%5c|%252f|%255c)"                 "traversal";
        "~*/\.(?:env|git|svn|hg|htpasswd|htaccess|ds_store|aws|ssh)(?:[/?\s]|$)"          "dotfile";
        "~*/(?:wp-config\.php|phpmyadmin|vendor/phpunit|cgi-bin/|boaform|hnap1|actuator/(?:env|heapdump))" "scanner";
        "~*^/@fs/"                                                                          "scanner";
        "~*(?:union(?:\s|%20|\+)+(?:all(?:\s|%20|\+)+)?select|information_schema|(?:sleep|benchmark)(?:\(|%28))" "sqli";
        "~*(?:<script|%3cscript|javascript:|onerror(?:=|%3d))"                             "xss";
        "~*(?:etc/passwd|proc/self/environ|pearcmd)"                                        "lfi";
        "~*(?:php|phar|expect|data)(?::|%3a)(?:/|%2f)(?:/|%2f)"                             "lfi";
        "~*(?:allow_url_include|auto_prepend_file|auto_append_file)(?:=|%3d)"              "php-cgi";
        "~*[?&+]%ad[a-z]"                                                                   "php-cgi";
        "~*(?:<|%3c)(?:\?|%3f)(?:php|=|%3d)"                                                "php-code";
        "~*(?:\$\{jndi:|%24%7bjndi)"                                                         "log4shell";
    }
{{range .RateLimits}}
    # Rate limit policy #{{.ID}} "{{.Name}}": {{.RequestsPerSecond}} r/s, burst {{.Burst}}{{if .DryRun}} (dry run){{end}}
    geo $corvus_rl{{.ID}}_exempt {
        default 0;
{{- range .ExemptCIDRs}}
        {{.}} 1;
{{- end}}
    }
    # Not limited: exempt networks, or requests a security rule allowed ($corvus_skip).
    map "$corvus_rl{{.ID}}_exempt$corvus_skip" $corvus_rl{{.ID}}_key {
        "0"     $binary_remote_addr;
        default "";
    }
    limit_req_zone $corvus_rl{{.ID}}_key zone=corvus_rl{{.ID}}:10m rate={{.RequestsPerSecond}}r/s;
{{- if gt .MaxConnections 0}}
    limit_conn_zone $corvus_rl{{.ID}}_key zone=corvus_cl{{.ID}}:10m;
{{- end}}
{{end}}
    # Access logs go to corvus-control over a Unix datagram socket (lossy, never blocks requests).
    # Proxy hosts send them from Lua in batches (corvus/accesslog.lua, same record format);
    # this per-request syslog output serves the other servers (unknown hosts, redirections).
    # Tab-separated, every value JSON-escaped (no raw tabs or newlines); parsed without
    # reflection by corvus-control (control/internal/traffic/parse.go: keep the field order).
    log_format corvus_log escape=json
        'c1\t$msec\t$corvus_host\t$request_method\t$status\t$body_bytes_sent\t$request_time\t'
        '$remote_addr\t$corvus_wr\t$corvus_exploit\t$limit_req_status\t$corvus_rule\t$corvus_cc\t'
        '$corvus_body\t$corvus_ban\t$uri\t$http_user_agent';
    # The same fields up to $corvus_ban, composed in C for the Lua access log (one variable
    # read instead of fourteen). None of them can contain a tab or newline: method and
    # address are validated by nginx, the others are set by Corvus.
    map $request_method $corvus_log_fields {
        default "$msec\t$corvus_host\t$request_method\t$status\t$body_bytes_sent\t$request_time\t$remote_addr\t$corvus_wr\t$corvus_exploit\t$limit_req_status\t$corvus_rule\t$corvus_cc\t$corvus_body\t$corvus_ban";
    }
    access_log syslog:server=unix:{{.P.DataDir}}/run/corvus-access.sock,nohostname,tag=corvus corvus_log;

    # HTTP-01 challenge answers from corvus-control (loopback), with a small keep-alive pool.
    upstream corvus_acme {
        server 127.0.0.1:{{.P.ACMEPort}};
        keepalive 4;
        keepalive_timeout 4s;
    }

    # Internal status endpoint (loopback only): corvus-control polls it after a reload
    # to confirm the new configuration version is actually serving.
    server {
        listen 127.0.0.1:{{.P.StatusPort}};
        access_log off;
        set $corvus_wr "-";
        set $corvus_host "_status";
        set $corvus_rule "";
        set $corvus_cc "";
        set $corvus_body "";
        set $corvus_ban "";
        set $corvus_skip "";
        set $corvus_auth "off";
        location = /version { default_type text/plain; return 200 "{{.Name}}"; }
        location = /healthz { default_type text/plain; return 200 "ok\n"; }
        # Ban list updates from corvus-control (loopback listener only).
        location = /bans {
            client_max_body_size 8m;
            client_body_buffer_size 8m;
            default_type text/plain;
            content_by_lua_block { require("corvus.rules").set_bans() }
        }
        # "Under attack" auto activations from corvus-control (loopback listener only).
        location = /under-attack {
            client_max_body_size 1m;
            client_body_buffer_size 1m;
            default_type text/plain;
            content_by_lua_block { require("corvus.rules").set_under_attack() }
        }
        # Bad-behaviour bans made by the gateway, polled by corvus-control (loopback only).
        location = /bad-behaviour {
            default_type application/json;
            content_by_lua_block { require("corvus.rules").bad_behaviour_hits() }
        }
        location / { return 404; }
    }

    # Requests for unknown hosts. TLS handshakes for unknown names are refused,
    # so no certificate (and none of its names) is disclosed (F11).
    server {
        listen {{.P.HTTPPort}} default_server;
        listen {{.P.HTTPSPort}} ssl default_server;
{{- if .P.IPv6}}
        listen [::]:{{.P.HTTPPort}} default_server;
        listen [::]:{{.P.HTTPSPort}} ssl default_server;
{{- end}}
        server_name _;
        ssl_reject_handshake on;
        set $corvus_wr "-";
        set $corvus_host "_";
        set $corvus_rule "";
        set $corvus_cc "";
        set $corvus_body "";
        set $corvus_ban "";

        location ^~ /.well-known/acme-challenge/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://corvus_acme;
        }
        location = /__corvus/healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }
        location / {
{{- if eq .Unknown.Mode "close"}}
            return 444;
{{- else if eq .Unknown.Mode "redirect"}}
            return 302 {{.Unknown.RedirectURL}};
{{- else}}
            default_type text/html;
            return 404 "<!doctype html><meta charset=utf-8><title>Corvus</title><p>No site is configured for this host.</p>\n";
{{- end}}
        }
    }

    # {{.Hosts}} proxy host(s), {{.Redirects}} redirection host(s)
    include {{.Dir}}/hosts/*.conf;
}
{{- if gt .Streams 0}}

# TCP/UDP port forwarding ({{.Streams}} stream(s)). No access log (nginx's stream default);
# errors go to the main error log.
stream {
    resolver {{.P.Resolver}} ipv6=off valid=30s;
    resolver_timeout 5s;
    proxy_connect_timeout 10s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:corvus_stream_ssl:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include {{.Dir}}/streams/*.conf;
}
{{- end}}
