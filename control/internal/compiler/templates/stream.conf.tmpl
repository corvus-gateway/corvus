# Stream {{.ID}} — generated by Corvus. Do not edit.
# Port {{.IncomingPort}}{{if .TCP}} TCP{{end}}{{if .UDP}} UDP{{end}} → {{.ForwardHost}}:{{.ForwardPort}}

# A name is resolved at run time ("resolve", stream-level resolver): a stopped or not yet
# created forward host never blocks deployment; connections fail until it resolves.
upstream corvus_stream_{{.ID}} {
{{- if .UpstreamResolve}}
    zone corvus_stream_{{.ID}} 64k;
    server {{.Upstream}}:{{.ForwardPort}} max_fails=0 resolve;
{{- else}}
    server {{.Upstream}}:{{.ForwardPort}} max_fails=0;
{{- end}}
}
{{- if and .TCP .SkipTCP}}

# TCP is not served yet: the certificate for TLS termination has not been issued.
{{- else if .TCP}}

server {
    listen {{.IncomingPort}}{{if .CertDir}} ssl{{end}}{{if .ProxyProtocolIn}} proxy_protocol{{end}};
{{- if .IPv6}}
    listen [::]:{{.IncomingPort}}{{if .CertDir}} ssl{{end}}{{if .ProxyProtocolIn}} proxy_protocol{{end}};
{{- end}}
{{- if .ProxyProtocolIn}}
    # Every connection must start with a PROXY protocol header; the client address is
    # taken from it only on connections from the trusted PROXY protocol sources.
{{- range .PPTrusted}}
    set_real_ip_from {{.}};
{{- end}}
{{- end}}
{{- if .CertDir}}
    ssl_certificate     {{.CertDir}}/fullchain.pem;
    ssl_certificate_key {{.CertDir}}/privkey.pem;
{{- end}}
    proxy_pass corvus_stream_{{.ID}};
{{- if .ProxyProtocolOut}}
    proxy_protocol on;  # the upstream receives the client address in a PROXY protocol (v1) header
{{- end}}
    proxy_timeout 1h;   # idle time before the connection is closed
}
{{- end}}
{{- if .UDP}}

server {
    listen {{.IncomingPort}} udp;
{{- if .IPv6}}
    listen [::]:{{.IncomingPort}} udp;
{{- end}}
    proxy_pass corvus_stream_{{.ID}};
    proxy_timeout 60s;  # idle time before the client's UDP session is dropped
}
{{- end}}
