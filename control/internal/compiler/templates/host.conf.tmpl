{{- define "guard" -}}
{{- if and .CertDir .SSLForced}}
        if ($corvus_https_redirect) { return 301 https://$host$request_uri; }
{{- end}}
{{- with .RateLimit}}
        limit_req zone=corvus_rl{{.ID}}{{if gt .Burst 0}} burst={{.Burst}} nodelay{{end}};
        limit_req_status {{.StatusCode}};
{{- if .DryRun}}
        limit_req_dry_run on;
{{- end}}
{{- if gt .MaxConnections 0}}
        limit_conn corvus_cl{{.ID}} {{.MaxConnections}};
        limit_conn_status {{.StatusCode}};
{{- if .DryRun}}
        limit_conn_dry_run on;
{{- end}}
{{- end}}
{{- end}}
{{- if .AccessFile}}
        # Basic auth; "off" when a security rule allowed the request with "skip Basic auth".
        auth_basic $corvus_auth;
        auth_basic_user_file {{.AccessFile}};
{{- end}}
{{- end -}}
{{- define "proxy" -}}
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Always the verified client address (after real-IP processing); client-supplied
            # X-Forwarded-For values are never passed on, so upstreams cannot be spoofed.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Framework-internal headers clients must never set (Next.js CVE-2025-29927).
            proxy_set_header X-Middleware-Subrequest "";
{{- if .Console}}
            # Admin console port: prove to the console that this request comes from the
            # gateway (a TCP stream to the console could not add it). Key from the environment.
            set_by_lua_block $corvus_gateway_key { return os.getenv("CORVUS_CONSOLE_KEY") or "" }
            proxy_set_header X-Corvus-Gateway $corvus_gateway_key;
{{- else}}
            proxy_set_header X-Corvus-Gateway "";
{{- end}}
{{- if eq .Scheme "https"}}
            proxy_ssl_server_name on;
            proxy_ssl_name {{.Addr}};   # SNI: the forward host (an IP address sends none)
{{- end}}
{{- if .Websocket}}
            proxy_set_header Upgrade $corvus_upgrade;
            proxy_set_header Connection $corvus_connection_upgrade;
{{- else}}
            proxy_set_header Connection "";
{{- end}}
{{- with .TimeoutS}}
{{- if not $.OwnReadTimeout}}
            proxy_read_timeout {{.}}s;
{{- end}}
{{- if not $.OwnSendTimeout}}
            proxy_send_timeout {{.}}s;
{{- end}}
{{- end}}
            proxy_pass {{.Scheme}}://{{.Name}}{{.Path}};
{{- if .ErrorCodes}}
            # Upstream down / timed out: Corvus error page. Error responses the
            # upstream itself sends are passed through unchanged.
{{- range .ErrorCodes}}
            error_page {{.}} @corvus_e{{.}};
{{- end}}
{{- if .RateLimit}}
            # A location with its own error_page does not inherit the server's.
            error_page {{.RateLimit.StatusCode}} = @corvus_limited;
{{- end}}
{{- end}}
{{- if .Advanced}}

        # --- location advanced configuration (operator supplied) ---
{{.Advanced}}
        # --- end location advanced configuration ---
{{- end}}
{{- end -}}
{{- define "upstream" -}}
upstream {{.Name}} {
{{- if .Resolve}}
    zone {{.Name}} 64k;
    server {{.Addr}}:{{.Port}} max_fails=0 resolve;
{{- else}}
    server {{.Addr}}:{{.Port}} max_fails=0;
{{- end}}
    keepalive 64;
    keepalive_requests 10000;
    # Shorter than the idle timeout of common backends (Node.js 5 s, Apache 5 s), so the
    # gateway closes an idle connection before the backend does.
    keepalive_timeout 4s;
}
{{- end -}}
{{- define "queue" -}}
{{- if .Room}}
{{- if eq .WaitroomPath "/"}}
        set $corvus_room "{{.Room.Name}}";
        access_by_lua_block { require("corvus.waitroom").access() }
{{- else}}
        # Access queue for requests under the protected path (same match as its location).
        set $corvus_room $corvus_qroom_{{.ID}};
        access_by_lua_block { if ngx.var.corvus_room ~= "" then require("corvus.waitroom").access() end }
{{- end}}
{{- end}}
{{- end -}}
# Proxy host {{.ID}} — generated by Corvus. Do not edit.

# Forward host with a per-worker pool of idle keep-alive connections (no TCP handshake per
# request). A name is resolved at run time ("resolve", http-level resolver, re-resolved
# when the DNS answer expires): a stopped or not yet created upstream never blocks
# deployment, it answers 502 until the name resolves. max_fails=0: no passive health
# state, every request tries the upstream (as with a single server).
{{template "upstream" .Host}}
{{- range .LocUpstreams}}

# Custom location {{.Prefix}}
{{template "upstream" .}}
{{- end}}
{{- if and .Room (ne .WaitroomPath "/") .Locations}}

# Custom locations: access queue room for paths under the protected path.
map $uri $corvus_qroom_{{.ID}} {
    default "";
    "~*^{{rxpath .WaitroomPath}}(?:[/;]|$)" "{{.Room.Name}}";
}
{{- end}}

server {
    listen {{.P.HTTPPort}};
{{- if .P.IPv6}}
    listen [::]:{{.P.HTTPPort}};
{{- end}}
{{- if .CertDir}}
    listen {{.P.HTTPSPort}} ssl;
{{- if .P.IPv6}}
    listen [::]:{{.P.HTTPSPort}} ssl;
{{- end}}
{{- if .HTTP2}}
    http2 on;
{{- end}}
    ssl_certificate     {{.CertDir}}/fullchain.pem;
    ssl_certificate_key {{.CertDir}}/privkey.pem;
{{- end}}
    server_name {{join .Domains " "}};

    set $corvus_host "{{index .Domains 0}}";
    # Forward host address (for advanced configuration; the proxy uses corvus_up_{{.ID}}).
    set $corvus_upstream "{{.Upstream}}";
    set $corvus_wr "-";
    set $corvus_rule "";
    set $corvus_cc "";
    set $corvus_body "";
    set $corvus_ban "";
    set $corvus_skip "";
    set $corvus_auth "Restricted";
{{- if .UploadLimit}}
    client_max_body_size {{.UploadLimit}};{{if eq .UploadLimit "0"}}   # unlimited{{end}}
{{- end}}
{{- if .GzipOff}}
    gzip off;
{{- end}}

    # Security rules and attack-pattern blocking run in the rewrite phase — before
    # rate limiting, Basic auth and the access queue (corvus/rules.lua).
    rewrite_by_lua_block { require("corvus.rules").rewrite({{.ID}}) }
    # Access log (batched per worker, corvus/accesslog.lua) and bad-behaviour counting
    # (error responses per client IP). nginx's per-request syslog output is off here
    # (unless the advanced configuration brings its own access_log).
{{- if not .OwnAccessLog}}
    access_log off;
{{- end}}
    log_by_lua_block { require("corvus.rules").log({{.ID}}{{if .Room}}, true{{end}}) }
{{- if eq .ClientIP "cloudflare"}}

    # Client IP: trust CF-Connecting-IP only from Cloudflare edge addresses.
{{- range .Cloudflare}}
    set_real_ip_from {{.}};
{{- end}}
    real_ip_header CF-Connecting-IP;
{{- else if eq .ClientIP "trusted_proxies"}}

    # Client IP: trust {{.RealIPHeader}} only from configured proxies.
{{- range .TrustedProxies}}
    set_real_ip_from {{.}};
{{- end}}
    real_ip_header {{.RealIPHeader}};
    real_ip_recursive on;
{{- end}}
{{- if and .CertDir .SSLForced}}

    set $corvus_https_redirect "";
    if ($scheme = http) { set $corvus_https_redirect 1; }
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- if .HasRootLocation}}
    # The advanced configuration defines "location /", which has no Corvus redirect:
    # redirect at server level (certificate validation excepted).
    if ($request_uri ~ "^/\.well-known/acme-challenge/") { set $corvus_https_redirect ""; }
    if ($corvus_https_redirect) { return 301 https://$host$request_uri; }
{{- end}}
{{- end}}
{{- if .RateLimit}}

    error_page {{.RateLimit.StatusCode}} = @corvus_limited;
    location @corvus_limited {
        default_type application/json;
        add_header Retry-After 1 always;
        return {{.RateLimit.StatusCode}} '{"error":"rate_limited","message":"Too many requests"}';
    }
{{- end}}

{{- if or .Room (ne .SecurityHeaders "off")}}

    # Response headers: one header_filter for the server, inherited by every location
    # (security header preset: corvus/headers.lua; waiting room cookies: corvus/waitroom.lua).
    header_filter_by_lua_block {
{{- if ne .SecurityHeaders "off"}}
        require("corvus.headers").header_filter("{{.SecurityHeaders}}")
{{- end}}
{{- if .Room}}
        require("corvus.waitroom").header_filter()
{{- end}}
    }
{{- end}}

    location ^~ /.well-known/acme-challenge/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://corvus_acme;
    }

    # Security-rule challenge answers (corvus/challenge.lua). Bans and block rules still
    # apply (server rewrite phase); POST only, small bodies, rate-limited per client IP.
    location = /__corvus/challenge/verify {
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        limit_req zone=corvus_ch_client burst=20 nodelay;
        limit_req_status 429;
        default_type text/html;
        content_by_lua_block { require("corvus.rules").challenge_verify({{.ID}}) }
    }

    # Upstream error pages (502/503/504, corvus/rules.lua). Named locations: not
    # reachable by clients; the security rules already ran for this request.
{{- range .ErrorCodes}}
    location @corvus_e{{.}} {
        rewrite_by_lua_block { return }
        content_by_lua_block { require("corvus.rules").upstream_error({{.}}) }
    }
{{- end}}


    # Other /__corvus/ paths do not exist. Answer them here: the security rules leave
    # this prefix alone (it is the gateway's own), so it must never reach the upstream.
    location ^~ /__corvus/ {
        return 404;
    }
{{- if .RoomEndpoints}}

    # Waiting room "{{.RoomEndpoints.Name}}" (capacity {{.RoomEndpoints.Capacity}}, fail-{{.RoomEndpoints.FailMode}}{{if not .Room}}, disabled: status endpoints only{{end}})
    set $corvus_host_room "{{.RoomEndpoints.Name}}";

    # Waiting room endpoints get the same access list / exploit / rate-limit guard as
    # the site, plus a dedicated per-IP limit for the status API (F2).
    location ^~ /__corvus/wr/ {
{{- template "guard" .}}
        limit_req zone=corvus_wr_client burst=1000 nodelay;
        limit_req_status 429;
        content_by_lua_block { require("corvus.waitroom").endpoint() }
    }
    location ^~ /__corvus/wait/ {
{{- template "guard" .}}
        root {{.P.HTMLDir}};
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "public, max-age=60" always;
        try_files /wait.html =404;
    }
{{- if and .Room (ne .WaitroomPath "/")}}

    # Protected path: case-insensitive and ";"-parameter aware so backends with
    # different path semantics cannot be used to bypass the waiting room (F4).
    location ~* "^{{rxpath .WaitroomPath}}(?:[/;]|$)" {
{{- template "guard" .}}
        set $corvus_room "{{.Room.Name}}";
        access_by_lua_block { require("corvus.waitroom").access() }
{{template "proxy" .Root}}
    }
{{- end}}
{{- end}}
{{- range .Locations}}

    # Custom location (prefix; "^~": regular-expression locations do not take it over).
    # Same protections as the rest of the host: security rules and bans (server rewrite
    # phase), rate limit, Basic auth and the access queue.
    location ^~ {{.Prefix}} {
{{- template "guard" $}}
{{- template "queue" $}}
{{template "proxy" .}}
    }
{{- end}}
{{- if .AdvancedConfig}}

    # --- advanced configuration (operator supplied) ---
{{.AdvancedConfig}}
    # --- end advanced configuration ---
{{- end}}
{{- if not .HasRootLocation}}

    location / {
{{- template "guard" .}}
{{- if and .Room (eq .WaitroomPath "/")}}
        set $corvus_room "{{.Room.Name}}";
        access_by_lua_block { require("corvus.waitroom").access() }
{{- end}}
{{template "proxy" .Root}}
    }
{{- end}}
}
